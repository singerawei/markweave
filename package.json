{
  "name": "markweave",
  "version": "2.1.0",
  "displayName": "MarkWeave — Modular Markdown Editor",
  "publisher": "markweave",
  "icon": "media/markweave-icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:markweave.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "markweave.editor",
        "displayName": "Modular Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.MD"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markweave.open",
        "title": "MarkWeave: Open WYSIWYG Editor"
      },
      {
        "command": "markweave.save",
        "title": "MarkWeave: Save",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.saveAs",
        "title": "MarkWeave: Save As",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.exportPdf",
        "title": "MarkWeave: Export PDF"
      },
      {
        "command": "markweave.bold",
        "title": "MarkWeave: Bold",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.italic",
        "title": "MarkWeave: Italic",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.inlineCode",
        "title": "MarkWeave: Inline Code",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.undo",
        "title": "MarkWeave: Undo",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.redo",
        "title": "MarkWeave: Redo",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.find",
        "title": "MarkWeave: Find in Document",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.outline",
        "title": "MarkWeave: Document Outline",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.navigate",
        "title": "MarkWeave: Navigate",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.pinNavigation",
        "title": "MarkWeave: Pin Navigation",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.toggleToolbar",
        "title": "MarkWeave: Toggle Toolbar",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.focusMode",
        "title": "MarkWeave: Focus Mode",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.help",
        "title": "MarkWeave: Help",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.manageIncludes",
        "title": "MarkWeave: Manage Includes",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.revealSource",
        "title": "MarkWeave: Reveal Source",
        "enablement": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.insert",
        "title": "MarkWeave: Insert",
        "enablement": "activeCustomEditorId == markweave.editor"
      }
    ],
    "keybindings": [
      {
        "command": "markweave.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.saveAs",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.outline",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.outline",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.pinNavigation",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.toggleToolbar",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.insert",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.focusMode",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.help",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == markweave.editor"
      },
      {
        "command": "markweave.exportPdf",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "activeCustomEditorId == markweave.editor"
      }
    ],
    "configuration": {
      "title": "MarkWeave",
      "properties": {
        "markweave.defaultNavigationMode": {
          "type": "string",
          "enum": [
            "find",
            "outline"
          ],
          "default": "find",
          "description": "Navigation mode used when a document has no saved preference."
        },
        "markweave.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Show the MarkWeave toolbar for documents without a saved preference."
        }
      }
    },
    "menus": {
      "webview/context": [
        {
          "command": "markweave.exportPdf",
          "when": "webviewSection == markweave",
          "group": "navigation"
        },
        {
          "command": "markweave.revealSource",
          "when": "webviewSection == markweave",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "npm run build",
    "lint": "eslint src tests bench",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts tests/roundtrip.test.ts tests/markdown-extensions.test.ts tests/review.test.ts tests/contract.test.ts tests/gates.test.mjs",
    "test:ui": "playwright test",
    "test:host": "node scripts/test-host.mjs",
    "bench": "tsx bench/run.ts",
    "package": "node scripts/bundle-engine.mjs && vsce package --target win32-x64 --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "release:gate": "node scripts/check-release.mjs",
    "test:review": "node scripts/prepare-review.mjs && node scripts/verify-review.mjs"
  },
  "keywords": [
    "markdown",
    "wysiwyg",
    "markdown-editor",
    "markdown-preview",
    "includes",
    "mermaid",
    "pdf",
    "math",
    "footnotes",
    "gfm",
    "typora",
    "obsidian",
    "markweave"
  ],
  "author": "singerawei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/singerawei/markweave.git"
  },
  "bugs": {
    "url": "https://github.com/singerawei/markweave/issues"
  },
  "homepage": "https://github.com/singerawei/markweave#readme",
  "description": "MarkWeave — local-first WYSIWYG Markdown with editable includes, extended syntax and PDF export.",
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "0.18.2",
    "lucide": "^1.66.0",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "mermaid": "^11.17.2",
    "playwright-core": "^1.64.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.9",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
